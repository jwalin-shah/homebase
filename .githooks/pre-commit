#!/bin/bash
# Pre-commit hook: Run before commit is created
# Catches common bugs locally, fail fast
#
# Install: ln -sf ../../.githooks/pre-commit .git/hooks/pre-commit
# Bypass: git commit --no-verify (discouraged, logged)

set -e

STAGED_FILES=$(git diff --cached --name-only)

echo "🔍 Running pre-commit checks..."

# Check 1: No unhandled errors
echo "  → Checking for unhandled error returns..."
if git diff --cached *.go 2>/dev/null | grep "^+.*_ = " | grep -v "for _" | grep -v range; then
  echo "❌ FAIL: Unhandled error found in staged changes"
  echo "   Every error return must be explicitly handled"
  exit 1
fi

# Check 2: No hardcoded config values
echo "  → Checking for hardcoded config (localhost, :7474, /tmp)..."
if git diff --cached *.go 2>/dev/null | grep "^+" | grep -E "localhost|:7474|/tmp/ledger"; then
  echo "❌ FAIL: Hardcoded config value found"
  echo "   Use environment variables or config files instead"
  exit 1
fi

# Check 3: No :memory: databases in non-test code
echo "  → Checking for :memory: in production code..."
if git diff --cached *.go 2>/dev/null | grep "^+" | grep ":memory:" | grep -v "_test.go"; then
  echo "❌ FAIL: :memory: database in production code"
  echo "   Only use :memory: in *_test.go files"
  exit 1
fi

# Check 4: Signature verification exists
echo "  → Checking for unverified signatures..."
ADDED_SIGS=$(git diff --cached *.go 2>/dev/null | grep "^+.*\.Signature = " | wc -l)
VERIFY_CALLS=$(git diff --cached *.go 2>/dev/null | grep "^+.*[Vv]erify" | wc -l)
if [ $ADDED_SIGS -gt 0 ] && [ $VERIFY_CALLS -eq 0 ]; then
  echo "⚠️  WARNING: Signature assignments found, but no Verify() calls"
  echo "   If intentional, add comment: // signature verified upstream"
fi

# Check 5: Format check (gofmt)
echo "  → Checking code format..."
for FILE in $STAGED_FILES; do
  if [[ $FILE == *.go ]]; then
    if ! gofmt -l "$FILE" 2>/dev/null | grep -q "$FILE"; then
      continue
    else
      echo "❌ FAIL: File $FILE not properly formatted"
      echo "   Run: gofmt -w $FILE"
      exit 1
    fi
  fi
done

# Check 6: No secrets in staged changes
echo "  → Checking for secrets (API keys, tokens)..."
if git diff --cached 2>/dev/null | grep -E "password|api.?key|token|secret" | grep -v "//"; then
  echo "⚠️  WARNING: Possible secret in staged changes"
  echo "   Review above lines. Use environment variables instead."
fi

echo "✓ Pre-commit checks passed"
exit 0
